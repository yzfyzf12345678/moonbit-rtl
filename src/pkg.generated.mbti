pub fn TraceArchive::unknown_trace_count(Self) -> Int
pub fn TraceArchive::validate(Self) -> Array[String]
pub fn TraceArchive::with_metadata(Self, String, String) -> Self

pub struct TraceDifference {
  cycle : Int
  signal : String
  expected : LogicVector?
  actual : LogicVector?
  reason : String
}

pub struct TraceEvent {
  cycle : Int
  signal : String
  value : LogicVector
  kind : TraceEventKind
  source : String
}

pub enum TraceEventKind {
  TraceInput
  TraceOutput
  TraceInternal
  TraceState
  TraceUnknown
} derive(Eq)

pub struct TracePolicy {
  max_cycles : Int
  include_internal : Bool
  stop_on_stable : Bool
  unknown_is_error : Bool
  compare_inputs : Bool
}
pub fn TracePolicy::bounded(Self, Int) -> Self
pub fn TracePolicy::default() -> Self
pub fn TracePolicy::strict(Self) -> Self

pub struct TraceReplayResult {
  module_name : String
  compared_events : Int
  differences : Array[TraceDifference]
  passed : Bool
  expected_cycles : Int
  actual_cycles : Int
}
pub fn TraceReplayResult::difference_count(Self) -> Int
pub fn TraceReplayResult::difference_signals(Self) -> Array[String]
pub fn TraceReplayResult::is_clean(Self) -> Bool
pub fn TraceReplayResult::to_json(Self) -> String
pub fn TraceReplayResult::to_markdown(Self) -> String

pub struct TraceSelector {
  signal_contains : String
  kind : TraceEventKind?
  first_cycle : Int
  last_cycle : Int
  include_unknown : Bool
}
pub fn TraceSelector::all() -> Self
pub fn TraceSelector::cycles(Self, Int, Int) -> Self
pub fn TraceSelector::from_kind_text(String) -> Self
pub fn TraceSelector::kind(Self, TraceEventKind) -> Self
pub fn TraceSelector::signal(Self, String) -> Self
pub fn TraceSelector::without_unknown(Self) -> Self

pub struct TraceStatistics {
  event_count : Int
  input_count : Int
  output_count : Int
  internal_count : Int
  unknown_count : Int
  cycle_count : Int
  unique_signals : Int
}

pub enum VectorMode {
  ZeroVector
  OnesVector
  WalkingOneVector
  WalkingZeroVector
  AlternatingVector
  BoundaryVector
} derive(Eq)

pub struct VerificationObservation {
  vector_name : String
  status : String
  checked_outputs : Int
  mismatches : Array[String]
  stable : Bool
  iterations : Int
}

pub struct VerificationPlan {
  module_name : String
  requirements : Array[VerificationRequirement]
  vectors : Array[VerificationVector]
  max_iterations : Int
}
pub fn VerificationPlan::add_requirement(Self, String, String, String, Int) -> Self
pub fn VerificationPlan::add_vector(Self, VerificationVector) -> Self
pub fn VerificationPlan::empty(String) -> Self

pub struct VerificationReport {
  module_name : String
  observations : Array[VerificationObservation]
  requirements : Array[VerificationRequirement]
  passed : Int
  failed : Int
  unknown : Int
}
pub fn VerificationReport::coverage_percent(Self) -> Int
pub fn VerificationReport::is_healthy(Self) -> Bool
pub fn VerificationReport::to_json(Self) -> String
pub fn VerificationReport::to_markdown(Self) -> String
pub fn VerificationReport::total(Self) -> Int

pub struct VerificationRequirement {
  id : String
  target : String
  description : String
  priority : Int
  covered : Bool
}

pub struct VerificationVector {
  name : String
  mode : VectorMode
  inputs : Array[(String, LogicVector)]
  expected : Array[(String, LogicVector)]
  tags : Array[String]
}

pub struct Width {
  msb : Int
  lsb : Int
}
pub fn Width::bits(Self) -> Int
pub fn Width::is_descending(Self) -> Bool
pub fn Width::single() -> Self

pub struct WidthFact {
  expression : String
  actual : Int?
  expected : Int?
  source_line : Int
  source_column : Int
}

pub struct WidthReport {
  facts : Array[WidthFact]
  unknown : Int
  mismatches : Int
}
pub fn WidthReport::to_json(Self) -> String

pub struct WorkspaceFinding {
  path : String
  diagnostic : Diagnostic
}

pub struct WorkspaceResult {
  files : Int
  findings : Array[WorkspaceFinding]
  summaries : Array[SourceSummary]
  errors : Int
  warnings : Int
}
pub fn WorkspaceResult::exit_code(Self) -> Int
pub fn WorkspaceResult::sorted_findings(Self) -> Array[WorkspaceFinding]
pub fn WorkspaceResult::status_line(Self) -> String
pub fn WorkspaceResult::to_json(Self) -> String
pub fn WorkspaceResult::to_markdown(Self) -> String

